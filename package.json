{
  "name": "@kocdigital/p360-user-vue-plugin",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Koç Digital Platform360 User Vue Plugin",
  "homepage": "https://github.com/@kocdigital/p360-user-vue-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/@kocdigital/p360-user-vue-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/@kocdigital/p360-user-vue-plugin/issues"
  },
  "keywords": [
    "kocdigital",
    "p360",
    "user",
    "vue",
    "vue-plugin",
    "user-vue-plugin",
    "platform360",
    "p360-user-vue-plugin",
    "p360-user"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "require": "./dist/models.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ],
      "./models": [
        "dist/models.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@kocdigital/sf-interface": "^1.0.5",
    "vue": "~2.6.0"
  },
  "dependencies": {
    "lodash.isequal": "^4.5.0"
  },
  "devDependencies": {
    "@kocdigital/sf-interface": "^1.0.5",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "~16.18.98",
    "tsup": "~6.7.0",
    "typescript": "~5.3.2",
    "vue": "~2.6.0"
  },
  "engines": {
    "node": "16.x"
  }
}
